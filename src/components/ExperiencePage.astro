---
import BaseLayout from '../layouts/BaseLayout.astro'
import { translations, type Language } from '../i18n'
import { Image, getImage } from 'astro:assets'
import adventureImage from '../assets/experience/wonderland-games/numberphile/adventure.png'
import adventure11Image from '../assets/experience/wonderland-games/numberphile/adventure-11.png'
import adventure13Image from '../assets/experience/wonderland-games/numberphile/adventure-13.png'
import adventure19Image from '../assets/experience/wonderland-games/numberphile/adventure-19.png'
import levelImage from '../assets/experience/wonderland-games/numberphile/level.png'
import menuImage from '../assets/experience/wonderland-games/numberphile/menu.png'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = translations[language]

const wonderlandSources = [
  adventure11Image,
  adventure13Image,
  adventure19Image,
  menuImage,
  adventureImage,
  levelImage,
]

const wonderlandGallery = await Promise.all(
  wonderlandSources.map(async (src, index) => ({
    src,
    alt: t.experienceGalleryItems[index],
    fullSize: await getImage({
      src,
      width: Math.min(src.width, 1600),
      format: 'webp',
      quality: 85,
    }),
  })),
)
---

<BaseLayout
  language={language}
  currentPage="experience"
  title={`${t.experienceTitle} — Kemuna`}
  description={t.pageDescription}
>
  <section class="page-section" aria-labelledby="page-title">
    <p class="section-label">02</p>
    <h1 id="page-title" class="page-title">{t.experienceTitle}</h1>

    <div class="experience-list">
      <article class="experience-item">
        <div>
          <h2>{t.currentExperienceRole}</h2>
          <p>
            <a class="company-link" href="https://assol.in.ua/" target="_blank" rel="noreferrer">
              {t.currentExperienceCompany}
            </a>
          </p>
        </div>
        <div class="experience-meta">
          <p>{t.currentExperienceLocation}</p>
          <p>{t.currentExperiencePeriod}</p>
        </div>
        <div class="experience-details">
          <p>{t.currentExperienceDescription}</p>

          <div class="experience-block">
            <h3>{t.responsibilitiesTitle}</h3>
            <ul class="responsibility-list">
              {t.currentExperienceResponsibilities.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="experience-block">
            <h3>{t.projectsTitle}</h3>
            <p>{t.currentExperienceProjects}</p>
          </div>

          <div class="experience-block">
            <h3>{t.skillsTitle}</h3>
            <ul class="skill-list">
              {t.currentExperienceSkills.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="gallery-placeholder">{t.experienceGalleryPlaceholder}</div>
        </div>
      </article>

      <article class="experience-item">
        <div>
          <h2>{t.experienceRole}</h2>
          <p>
            <a
              class="company-link"
              href="https://www.wonderland-games.com/"
              target="_blank"
              rel="noreferrer"
            >
              Wonderland Games
            </a>
          </p>
        </div>
        <div class="experience-meta">
          <p>{t.experienceLocation}</p>
          <p>{t.experiencePeriod}</p>
        </div>
        <div class="experience-details">
          <p>{t.experienceDescription}</p>

          <div class="experience-block">
            <h3>{t.responsibilitiesTitle}</h3>
            <ul class="responsibility-list">
              {t.experienceResponsibilities.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="experience-block">
            <h3>{t.projectsTitle}</h3>
            <p>
              <a
                class="project-link"
                href="https://www.wonderland-games.com/projects/numberphile/"
                target="_blank"
                rel="noreferrer"
              >
                <strong>{t.experienceProjectName}</strong>
              </a>. {t.experienceProjectDescription}
            </p>
          </div>

          <div class="experience-block">
            <h3>{t.skillsTitle}</h3>
            <ul class="skill-list">
              {t.experienceSkills.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="experience-block">
            <h3>{t.galleryTitle}</h3>
            <portfolio-gallery>
              <div class="experience-gallery">
                {
                  wonderlandGallery.map((item) => (
                    <button
                      class="experience-gallery-button"
                      type="button"
                      data-full-image={item.fullSize.src}
                      data-image-alt={item.alt}
                      aria-label={`${t.openImageLabel}: ${item.alt}`}
                    >
                      <Image
                        src={item.src}
                        alt={item.alt}
                        widths={[320, 480, 720]}
                        sizes="(max-width: 640px) calc(100vw - 2rem), 24rem"
                        format="webp"
                        quality={80}
                        loading="lazy"
                      />
                    </button>
                  ))
                }
              </div>

              <dialog class="image-lightbox">
                <form method="dialog">
                  <button class="lightbox-close" aria-label={t.closeImageLabel}>
                    <span aria-hidden="true">×</span>
                  </button>
                </form>
                <img src="" alt="" />
              </dialog>
            </portfolio-gallery>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  class PortfolioGallery extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector<HTMLDialogElement>('.image-lightbox')
      const fullImage = dialog?.querySelector<HTMLImageElement>('img')

      if (!dialog || !fullImage) return

      this.querySelectorAll<HTMLButtonElement>('[data-full-image]').forEach((button) => {
        button.addEventListener('click', () => {
          fullImage.src = button.dataset.fullImage ?? ''
          fullImage.alt = button.dataset.imageAlt ?? ''
          dialog.showModal()
        })
      })

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })

      dialog.addEventListener('close', () => {
        fullImage.removeAttribute('src')
        fullImage.alt = ''
      })
    }
  }

  if (!customElements.get('portfolio-gallery')) {
    customElements.define('portfolio-gallery', PortfolioGallery)
  }
</script>
