---
interface Props {
  closeLabel: string
  dialogLabel: string
  nextLabel: string
  previousLabel: string
}

const { closeLabel, dialogLabel, nextLabel, previousLabel } = Astro.props
---

<portfolio-gallery>
  <slot />

  <dialog class="image-lightbox" aria-label={dialogLabel}>
    <div class="lightbox-shell">
      <div class="lightbox-toolbar">
        <span class="lightbox-counter" aria-live="polite"></span>
        <button class="lightbox-close" type="button" aria-label={closeLabel} title={closeLabel}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m5 5 14 14M19 5 5 19"></path>
          </svg>
        </button>
      </div>

      <button
        class="lightbox-navigation lightbox-previous"
        type="button"
        aria-label={previousLabel}
        title={previousLabel}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m15 5-7 7 7 7"></path>
        </svg>
      </button>

      <div class="lightbox-stage">
        <img class="lightbox-image" alt="" />
      </div>

      <button
        class="lightbox-navigation lightbox-next"
        type="button"
        aria-label={nextLabel}
        title={nextLabel}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m9 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </dialog>
</portfolio-gallery>

<script>
  class PortfolioGallery extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === 'true') return
      this.dataset.initialized = 'true'

      const triggers = Array.from(
        this.querySelectorAll<HTMLButtonElement>('[data-full-image]'),
      )
      const dialog = this.querySelector<HTMLDialogElement>('.image-lightbox')
      const stage = this.querySelector<HTMLElement>('.lightbox-stage')
      const fullImage = this.querySelector<HTMLImageElement>('.lightbox-image')
      const counter = this.querySelector<HTMLElement>('.lightbox-counter')
      const previousButton = this.querySelector<HTMLButtonElement>('.lightbox-previous')
      const nextButton = this.querySelector<HTMLButtonElement>('.lightbox-next')
      const closeButton = this.querySelector<HTMLButtonElement>('.lightbox-close')

      if (
        triggers.length === 0 ||
        !dialog ||
        !stage ||
        !fullImage ||
        !counter ||
        !previousButton ||
        !nextButton ||
        !closeButton
      ) {
        return
      }

      let currentIndex = 0
      let orderedTriggers = [...triggers]
      let changeTimer = 0
      let closeTimer = 0
      let imageChangeId = 0
      let activeTrigger: HTMLButtonElement | undefined
      let sharedImageAnimation: Animation | undefined
      let sharedImageClone: HTMLImageElement | undefined
      let touchStartX = 0
      let touchStartY = 0

      const switchClasses = [
        'is-leaving-next',
        'is-leaving-previous',
        'is-entering-next',
        'is-entering-previous',
        'is-positioning',
      ]

      previousButton.hidden = triggers.length < 2
      nextButton.hidden = triggers.length < 2

      const getRenderedImageRect = (trigger: HTMLButtonElement) => {
        const image = trigger.querySelector('img')
        if (!(image instanceof HTMLImageElement)) return trigger.getBoundingClientRect()

        const bounds = image.getBoundingClientRect()
        if (image.naturalWidth === 0 || image.naturalHeight === 0) return bounds

        const scale = Math.min(
          bounds.width / image.naturalWidth,
          bounds.height / image.naturalHeight,
        )
        const width = image.naturalWidth * scale
        const height = image.naturalHeight * scale

        return new DOMRect(
          bounds.left + (bounds.width - width) / 2,
          bounds.top + (bounds.height - height) / 2,
          width,
          height,
        )
      }

      const getSharedTransform = (source: DOMRect, destination: DOMRect) => {
        const sourceCenterX = source.left + source.width / 2
        const sourceCenterY = source.top + source.height / 2
        const destinationCenterX = destination.left + destination.width / 2
        const destinationCenterY = destination.top + destination.height / 2

        return `translate3d(${sourceCenterX - destinationCenterX}px, ${sourceCenterY - destinationCenterY}px, 0) scale(${source.width / destination.width}, ${source.height / destination.height})`
      }

      const isVisibleInViewport = (rect: DOMRect) =>
        rect.width > 0 &&
        rect.height > 0 &&
        rect.bottom > 0 &&
        rect.right > 0 &&
        rect.top < window.innerHeight &&
        rect.left < window.innerWidth

      const clearSharedImage = () => {
        sharedImageAnimation?.cancel()
        sharedImageAnimation = undefined
        sharedImageClone?.remove()
        sharedImageClone = undefined
      }

      const createSharedImage = (rect: DOMRect, src: string) => {
        const image = document.createElement('img')
        image.className = 'lightbox-shared-image'
        image.src = src
        image.alt = ''
        image.setAttribute('aria-hidden', 'true')
        image.style.left = `${rect.left}px`
        image.style.top = `${rect.top}px`
        image.style.width = `${rect.width}px`
        image.style.height = `${rect.height}px`
        dialog.append(image)
        sharedImageClone = image
        return image
      }

      const showFullImageImmediately = () => {
        fullImage.style.transition = 'none'
        fullImage.classList.remove('is-shared-hidden')
        void fullImage.offsetWidth
        window.requestAnimationFrame(() => fullImage.style.removeProperty('transition'))
      }

      const refreshTriggerOrder = () => {
        const columns = new Map<
          number,
          Array<{ trigger: HTMLButtonElement; top: number }>
        >()

        triggers.forEach((trigger) => {
          const rect = trigger.getBoundingClientRect()
          const column = Math.round(rect.left / 16)
          const columnItems = columns.get(column) ?? []

          columnItems.push({ trigger, top: rect.top })
          columns.set(column, columnItems)
        })

        const orderedColumns = Array.from(columns.entries())
          .sort(([firstColumn], [secondColumn]) => firstColumn - secondColumn)
          .map(([, columnItems]) => columnItems.sort((first, second) => first.top - second.top))
        const longestColumn = Math.max(...orderedColumns.map((column) => column.length))

        orderedTriggers = []

        for (let row = 0; row < longestColumn; row += 1) {
          orderedColumns.forEach((column) => {
            const item = column[row]
            if (item) orderedTriggers.push(item.trigger)
          })
        }
      }

      const preloadAdjacentImages = () => {
        if (orderedTriggers.length < 2) return

        const adjacentIndexes = [
          (currentIndex - 1 + orderedTriggers.length) % orderedTriggers.length,
          (currentIndex + 1) % orderedTriggers.length,
        ]

        adjacentIndexes.forEach((index) => {
          const src = orderedTriggers[index]?.dataset.fullImage
          if (src) new window.Image().src = src
        })
      }

      const updateImage = (index: number, animate = false, direction: -1 | 1 = 1) => {
        currentIndex = (index + orderedTriggers.length) % orderedTriggers.length
        const trigger = orderedTriggers[currentIndex]
        activeTrigger = trigger
        const src = trigger?.dataset.fullImage ?? ''
        const alt = trigger?.dataset.imageAlt ?? ''
        const currentChangeId = ++imageChangeId

        window.clearTimeout(changeTimer)

        const applyImage = () => {
          fullImage.src = src
          fullImage.alt = alt
          counter.textContent = `${currentIndex + 1} / ${orderedTriggers.length}`
          preloadAdjacentImages()

          const revealImage = () => {
            if (currentChangeId !== imageChangeId) return

            if (animate) {
              const leavingClass = direction > 0 ? 'is-leaving-next' : 'is-leaving-previous'
              const enteringClass = direction > 0 ? 'is-entering-next' : 'is-entering-previous'

              fullImage.classList.add('is-positioning')
              fullImage.classList.remove(leavingClass)
              fullImage.classList.add(enteringClass)
              void fullImage.offsetWidth

              window.requestAnimationFrame(() => {
                if (currentChangeId !== imageChangeId) return

                fullImage.classList.remove('is-positioning')
                void fullImage.offsetWidth

                window.requestAnimationFrame(() => fullImage.classList.remove(enteringClass))
              })
              return
            }

            window.requestAnimationFrame(() => {
              window.requestAnimationFrame(() => fullImage.classList.remove(...switchClasses))
            })
          }

          if (!animate || fullImage.complete) {
            revealImage()
          } else {
            fullImage.addEventListener('load', revealImage, { once: true })
          }
        }

        if (animate) {
          fullImage.classList.remove(...switchClasses)
          fullImage.classList.add(direction > 0 ? 'is-leaving-next' : 'is-leaving-previous')
          changeTimer = window.setTimeout(applyImage, 340)
        } else {
          fullImage.classList.remove(...switchClasses)
          applyImage()
        }
      }

      const openGallery = (index: number) => {
        const trigger = orderedTriggers[(index + orderedTriggers.length) % orderedTriggers.length]
        const sourceRect = trigger ? getRenderedImageRect(trigger) : undefined
        const sourceImage = trigger?.querySelector('img')
        const previewSrc =
          sourceImage instanceof HTMLImageElement ? sourceImage.currentSrc || sourceImage.src : ''

        clearSharedImage()
        fullImage.classList.add('is-shared-hidden')
        dialog.classList.add('is-shared-opening')
        dialog.classList.remove('is-image-ready')
        updateImage(index)
        const currentChangeId = imageChangeId
        dialog.showModal()
        document.documentElement.classList.add('lightbox-open')

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => dialog.classList.add('is-open'))
        })

        void fullImage
          .decode()
          .catch(() => undefined)
          .then(() => {
            if (!dialog.open || currentChangeId !== imageChangeId) return
            dialog.classList.add('is-image-ready')

            window.requestAnimationFrame(() => {
              const destinationRect = fullImage.getBoundingClientRect()
              const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

              if (
                !sourceRect ||
                !isVisibleInViewport(sourceRect) ||
                !isVisibleInViewport(destinationRect) ||
                !previewSrc ||
                reducedMotion
              ) {
                showFullImageImmediately()
                dialog.classList.remove('is-shared-opening')
                return
              }

              const sharedImage = createSharedImage(destinationRect, previewSrc)
              const animation = sharedImage.animate(
                [
                  {
                    borderRadius: '0.5rem',
                    transform: getSharedTransform(sourceRect, destinationRect),
                  },
                  {
                    borderRadius: '0.125rem',
                    transform: 'translate3d(0, 0, 0) scale(1)',
                  },
                ],
                {
                  duration: 520,
                  easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                  fill: 'both',
                },
              )

              sharedImageAnimation = animation
              void animation.finished
                .catch(() => undefined)
                .finally(() => {
                  if (sharedImageAnimation !== animation) return
                  showFullImageImmediately()
                  dialog.classList.remove('is-shared-opening')
                  sharedImageAnimation = undefined
                  window.requestAnimationFrame(() => {
                    window.requestAnimationFrame(() => {
                      sharedImage.remove()
                      if (sharedImageClone === sharedImage) sharedImageClone = undefined
                    })
                  })
                })
            })
          })
      }

      const closeGallery = () => {
        if (
          !dialog.open ||
          dialog.classList.contains('is-closing') ||
          dialog.classList.contains('is-shared-closing')
        ) {
          return
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        if (reducedMotion) {
          dialog.classList.remove('is-open', 'is-image-ready')
          dialog.close()
          return
        }

        const targetRect = activeTrigger ? getRenderedImageRect(activeTrigger) : undefined
        const sourceRect = fullImage.getBoundingClientRect()

        if (targetRect && isVisibleInViewport(targetRect) && sourceRect.width > 0) {
          clearSharedImage()
          const sharedImage = createSharedImage(sourceRect, fullImage.currentSrc || fullImage.src)
          dialog.classList.remove('is-shared-opening')
          dialog.classList.add('is-shared-closing')

          void sharedImage
            .decode()
            .catch(() => undefined)
            .then(() => {
              window.requestAnimationFrame(() => {
                window.requestAnimationFrame(() => {
                  if (!dialog.open || sharedImageClone !== sharedImage) return

                  fullImage.classList.add('is-shared-hidden')
                  dialog.classList.remove('is-open')

                  const animation = sharedImage.animate(
                    [
                      {
                        borderRadius: '0.125rem',
                        transform: 'translate3d(0, 0, 0) scale(1)',
                      },
                      {
                        borderRadius: '0.5rem',
                        transform: getSharedTransform(targetRect, sourceRect),
                      },
                    ],
                    {
                      duration: 420,
                      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
                      fill: 'both',
                    },
                  )

                  sharedImageAnimation = animation
                  closeTimer = window.setTimeout(() => dialog.close(), 500)
                  void animation.finished
                    .catch(() => undefined)
                    .finally(() => {
                      if (sharedImageAnimation !== animation) return

                      window.requestAnimationFrame(() => {
                        window.requestAnimationFrame(() => {
                          if (sharedImageAnimation !== animation) return
                          sharedImageAnimation = undefined
                          if (dialog.open) dialog.close()
                        })
                      })
                    })
                })
              })
            })
          return
        }

        dialog.classList.remove('is-open', 'is-image-ready')
        dialog.classList.add('is-closing')
        closeTimer = window.setTimeout(() => dialog.close(), 360)
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          refreshTriggerOrder()
          openGallery(Math.max(orderedTriggers.indexOf(trigger), 0))
        })
      })

      previousButton.addEventListener('click', () => updateImage(currentIndex - 1, true, -1))
      nextButton.addEventListener('click', () => updateImage(currentIndex + 1, true, 1))
      closeButton.addEventListener('click', closeGallery)

      dialog.addEventListener('cancel', (event) => {
        event.preventDefault()
        closeGallery()
      })

      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') updateImage(currentIndex - 1, true, -1)
        if (event.key === 'ArrowRight') updateImage(currentIndex + 1, true, 1)
      })

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeGallery()
      })

      stage.addEventListener('click', (event) => {
        if (event.target === stage) closeGallery()
      })

      stage.addEventListener(
        'touchstart',
        (event) => {
          const touch = event.changedTouches[0]
          if (!touch) return
          touchStartX = touch.clientX
          touchStartY = touch.clientY
        },
        { passive: true },
      )

      stage.addEventListener(
        'touchend',
        (event) => {
          const touch = event.changedTouches[0]
          if (!touch) return

          const distanceX = touch.clientX - touchStartX
          const distanceY = touch.clientY - touchStartY

          if (Math.abs(distanceX) < 50 || Math.abs(distanceX) <= Math.abs(distanceY)) return
          const direction = distanceX < 0 ? 1 : -1
          updateImage(currentIndex + direction, true, direction)
        },
        { passive: true },
      )

      dialog.addEventListener('close', () => {
        imageChangeId += 1
        clearSharedImage()
        window.clearTimeout(changeTimer)
        window.clearTimeout(closeTimer)
        dialog.classList.remove(
          'is-open',
          'is-image-ready',
          'is-closing',
          'is-shared-opening',
          'is-shared-closing',
        )
        fullImage.classList.remove('is-shared-hidden', ...switchClasses)
        fullImage.style.removeProperty('transition')
        fullImage.removeAttribute('src')
        fullImage.alt = ''
        document.documentElement.classList.remove('lightbox-open')
      })
    }
  }

  if (!customElements.get('portfolio-gallery')) {
    customElements.define('portfolio-gallery', PortfolioGallery)
  }
</script>
