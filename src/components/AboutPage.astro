---
import BaseLayout from '../layouts/BaseLayout.astro'
import { translations, type Language } from '../i18n'
import { Image } from 'astro:assets'
import profilePhoto from '../assets/profile/profile-photo.jpg'

interface Props {
  language: Language
}

const { language } = Astro.props
const t = translations[language]
---

<BaseLayout
  language={language}
  currentPage="about"
  title={t.pageTitle}
  description={t.pageDescription}
>
  <section class="page-section about-page" aria-labelledby="page-title">
    <div class="profile-photo-drift">
      <div class="profile-photo-float">
        <div class="profile-photo-frame">
          <Image
            class="profile-photo"
            src={profilePhoto}
            alt={t.profilePhotoAlt}
            widths={[320, 384, 480, 640, 720, 960]}
            sizes="(max-width: 900px) min(calc(100vw - 2rem), 28rem), 36vw"
            format="webp"
            quality={85}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <div class="about-content">
      <h1 id="page-title">{t.realName}</h1>
      <p class="alias">kemuna</p>
      <p class="role">{t.role}</p>

      <div class="biography">
        <h2>{t.aboutTitle}</h2>
        {t.biography.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>
</BaseLayout>
