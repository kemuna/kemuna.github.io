---
import { ClientRouter, slide } from 'astro:transitions'
import '@fontsource-variable/manrope'
import '@fontsource-variable/onest'
import '../style.css'
import { languageNames, translations, type Language } from '../i18n'

type PageId = 'about' | 'experience' | 'work'

interface Props {
  language: Language
  currentPage: PageId
  title: string
  description: string
}

const { language, currentPage, title, description } = Astro.props
const t = translations[language]
const currentYear = new Date().getFullYear()
const alternateLanguage: Language = language === 'en' ? 'uk' : 'en'

const pagePaths: Record<PageId, string> = {
  about: '',
  experience: 'experience/',
  work: 'work/',
}

const navigation = [
  { id: 'about' as const, label: t.navAbout },
  { id: 'experience' as const, label: t.navExperience },
  { id: 'work' as const, label: t.navWork },
]

const currentPath = `/${language}/${pagePaths[currentPage]}`
const alternatePath = `/${alternateLanguage}/${pagePaths[currentPage]}`
const canonicalUrl = new URL(currentPath, Astro.site)
const alternateUrl = new URL(alternatePath, Astro.site)
const pageTransition = slide({ duration: '360ms' })
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow, noimageindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10090d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={language === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={alternateLanguage === 'uk' ? 'uk_UA' : 'en_US'}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={language} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLanguage} href={alternateUrl} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`https://kemuna.github.io/en/${pagePaths[currentPage]}`}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipLink}</a>

    <header class="site-header">
      <a class="wordmark" href={`/${language}/`}>kemuna</a>

      <nav class="main-nav" aria-label={t.navLabel}>
        {
          navigation.map((item) => (
            <a
              class:list={{ 'is-active': currentPage === item.id }}
              href={`/${language}/${pagePaths[item.id]}`}
              aria-current={currentPage === item.id ? 'page' : undefined}
              data-astro-prefetch="viewport"
            >
              {item.label}
            </a>
          ))
        }
        <a href="#contact">{t.navContact}</a>
      </nav>

      <div class="language-switcher" aria-label={t.languageLabel}>
        <a
          class:list={{ 'is-active': language === 'en' }}
          href={`/en/${pagePaths[currentPage]}`}
          hreflang="en"
          lang="en"
          aria-current={language === 'en' ? 'page' : undefined}
          data-language-link="en"
        >
          {languageNames.en}
        </a>
        <span aria-hidden="true">/</span>
        <a
          class:list={{ 'is-active': language === 'uk' }}
          href={`/uk/${pagePaths[currentPage]}`}
          hreflang="uk"
          lang="uk"
          aria-current={language === 'uk' ? 'page' : undefined}
          data-language-link="uk"
        >
          {languageNames.uk}
        </a>
      </div>
    </header>

    <main
      id="main"
      transition:name="page-content"
      transition:animate={pageTransition}
    >
      <slot />
    </main>

    <footer id="contact" class="site-footer" data-scroll-reveal>
      <ul class="footer-contacts" aria-label={t.contactLabel}>
        <li>
          <a
            class="social-link"
            href="mailto:danchenko.eliza@gmail.com"
            aria-label="Email: danchenko.eliza@gmail.com"
            title="danchenko.eliza@gmail.com"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3 5.75h18v12.5H3z"></path>
              <path d="m4 7 8 6 8-6"></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            class="social-link"
            href="https://t.me/seemperee"
            target="_blank"
            rel="noreferrer"
            aria-label="Telegram: @seemperee"
            title="@seemperee"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M21.5 3.5 18.4 19c-.2 1.1-.9 1.4-1.8.9l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-8c.4-.3-.1-.5-.6-.2L6.3 13l-4.7-1.5c-1-.3-1-1 .2-1.5l18.3-7.1c.9-.3 1.6.2 1.4.6Z"></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            class="social-link"
            href="https://www.instagram.com/kemuna.art"
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram"
            title="Instagram"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4.25"></circle>
              <circle class="instagram-dot" cx="17.4" cy="6.7" r="1"></circle>
            </svg>
          </a>
        </li>
      </ul>
      <p>© {currentYear} {t.realName} (kemuna)</p>
    </footer>

    <script>
      let scrollRevealObserver: IntersectionObserver | undefined

      const setupScrollReveal = () => {
        scrollRevealObserver?.disconnect()

        const elements = Array.from(
          document.querySelectorAll<HTMLElement>('[data-scroll-reveal]'),
        )
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        if (reducedMotion || !('IntersectionObserver' in window)) {
          elements.forEach((element) => {
            element.classList.remove('is-reveal-pending')
            element.classList.add('is-reveal-visible')
          })
          return
        }

        elements.forEach((element) => {
          element.classList.remove('is-reveal-visible')
          element.classList.add('is-reveal-pending')
        })

        scrollRevealObserver = new IntersectionObserver(
          (entries, observer) => {
            const visibleEntries = entries
              .filter((entry) => entry.isIntersecting)
              .sort((first, second) => {
                const verticalDifference = first.boundingClientRect.top - second.boundingClientRect.top

                if (Math.abs(verticalDifference) > 24) return verticalDifference
                return first.boundingClientRect.left - second.boundingClientRect.left
              })

            visibleEntries.forEach((entry, index) => {
              const element = entry.target as HTMLElement
              element.style.setProperty('--scroll-reveal-delay', `${Math.min(index * 55, 220)}ms`)
              element.classList.remove('is-reveal-pending')
              element.classList.add('is-reveal-visible')
              observer.unobserve(element)
            })
          },
          {
            rootMargin: '0px 0px -8% 0px',
            threshold: 0.08,
          },
        )

        elements.forEach((element) => scrollRevealObserver?.observe(element))
      }

      setupScrollReveal()
      document.addEventListener('astro:after-swap', setupScrollReveal)

      const restartProfileLevitation = () => {
        const profilePhoto = document.querySelector<HTMLElement>('.profile-photo-drift')
        if (!profilePhoto) return

        profilePhoto.classList.remove('is-levitating')
        void profilePhoto.offsetWidth

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            if (profilePhoto.isConnected) profilePhoto.classList.add('is-levitating')
          })
        })
      }

      restartProfileLevitation()
      document.addEventListener('astro:page-load', restartProfileLevitation)

      const getPagePosition = (url: URL) => {
        const pathParts = url.pathname.split('/').filter(Boolean)
        const pagePath = pathParts[1] ?? ''

        if (pagePath === '') return 0
        if (pagePath === 'experience') return 1
        if (pagePath === 'work') return 2

        return null
      }

      document.addEventListener('astro:before-preparation', (event) => {
        const fromPosition = getPagePosition(event.from)
        const toPosition = getPagePosition(event.to)

        if (fromPosition === null || toPosition === null) return

        if (fromPosition === toPosition) {
          event.to.hash = event.from.hash
          event.direction = 'language'
          return
        }

        event.direction = toPosition > fromPosition ? 'forward' : 'back'
      })

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target
          if (!(target instanceof Element)) return

          const link = target.closest<HTMLAnchorElement>('[data-language-link]')
          const language = link?.dataset.languageLink

          if (link && (language === 'en' || language === 'uk')) {
            try {
              localStorage.setItem('kemuna-language', language)
            } catch {
              // Language navigation still works when browser storage is unavailable.
            }

            link.hash = window.location.hash
          }
        },
        { capture: true },
      )
    </script>
  </body>
</html>
